# ---------- Google SSO (required) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application"
# Authorized redirect URI: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SERVER_BASE_URL=http://localhost:8000
# Optional: restrict sign-in to one Google Workspace domain (e.g. example.com). Empty = any Google account.
ALLOWED_DOMAIN=
# Optional but recommended in production: keeps MCP tokens valid across server restarts.
JWT_SIGNING_KEY=

# ---------- Roles ----------
# Preferred: members of this Google Workspace group are admins (checked via the Cloud Identity API).
# Needs the Cloud Identity API enabled in your Google Cloud project. Empty = disabled.
ADMIN_GROUP=
GROUP_CACHE_SECONDS=300
# Fallback: comma-separated emails that are always admins. Everyone else is a regular user.
ADMIN_EMAILS=admin@example.com

# ---------- Jira: per-user OAuth (recommended) ----------
# https://developer.atlassian.com/console/myapps/  -> Create "OAuth 2.0 integration"
#   Authorization callback URL: http://localhost:8000/jira/callback
#   Permissions > Jira API (classic): read:jira-work, write:jira-work, read:jira-user
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Optional: pick this site when a user has several. Empty = first site they can access.
JIRA_BASE_URL=https://your-site.atlassian.net
# Optional: key for encrypting stored Jira tokens (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# Empty = a key file (.token_key) is generated next to the app.
TOKEN_ENCRYPTION_KEY=

# ---------- Jira: shared service account (fallback, used when ATLASSIAN_* is empty) ----------
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
# Force a mode: user | service. Empty = user when ATLASSIAN_* is set, otherwise service.
JIRA_AUTH_MODE=

# ---------- Web app / misc ----------
WEBAPP_URL=http://localhost:3000
MCP_URL=http://localhost:8000/mcp
AUDIT_LOG=audit.log
